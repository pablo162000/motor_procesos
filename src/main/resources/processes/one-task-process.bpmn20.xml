        <sequenceFlow id="flow6" sourceRef="revisarR1" targetRef="syncRevisores"></sequenceFlow>
        <endEvent id="theEnd2"></endEvent>
        <sequenceFlow id="sid-9D2DC354-D29E-4050-9C57-C810947AE550" sourceRef="notificarRechazo" targetRef="theEnd2"></sequenceFlow>
        <sequenceFlow id="sid-4E071919-A6DD-407E-901D-1A663517AD8E" sourceRef="generarActa" targetRef="theEnd2"></sequenceFlow>
        <sequenceFlow id="flowRechazado" name="NO" sourceRef="decisionValidacion" targetRef="theEnd">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${validacionAprobada == false}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowAprobado" name="SI" sourceRef="decisionValidacion" targetRef="designarRevisores">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${validacionAprobada == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow11" name="SI" sourceRef="decisionNota" targetRef="generarActa">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${((NotaRevisor1 + NotaRevisor2) / 2) >= 11}]]></conditionExpression>

        </sequenceFlow>
        <sequenceFlow id="flow13" name="NO" sourceRef="decisionNota" targetRef="notificarRechazo">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${((NotaRevisor1 +NotaRevisor2)/2) < 11}]]></conditionExpression>
        </sequenceFlow>
