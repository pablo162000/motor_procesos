    <process id="procesoTesis" name="Ingreso propuesta tesis" isExecutable="true">
        <startEvent id="theStart" name="Envío Propuesta" flowable:formFieldValidation="true"></startEvent>
        <userTask id="validacionTema" name="Validación Tema" flowable:assignee="${idDireccion}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flow2" sourceRef="validacionTema" targetRef="decisionValidacion"></sequenceFlow>
        <exclusiveGateway id="decisionValidacion" name="¿Tema validado?"></exclusiveGateway>
        <userTask id="designarRevisores" name="Registrar aprobación" flowable:assignee="${idSecretaria}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <parallelGateway id="paraleloRevision" name="Inicio revisión"></parallelGateway>
        <sequenceFlow id="flow4" sourceRef="paraleloRevision" targetRef="revisarR1"></sequenceFlow>
        <userTask id="revisarR1" name="Revisar propuesta" flowable:assignee="${idRevisor1}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <boundaryEvent id="timerRevisor1" attachedToRef="revisarR1" cancelActivity="true">
            <timerEventDefinition>
                <timeDuration>PT240H</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>
        <serviceTask id="recordarRevisor1" name="Recordar revisor 1" flowable:delegateExpression="${recordatorioRevisor1}"></serviceTask>
        <userTask id="revisarR2" name="Revisar propuesta" flowable:assignee="${idRevisor2}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <boundaryEvent id="timerRevisor2" attachedToRef="revisarR2" cancelActivity="true">
            <timerEventDefinition>
                <timeDuration>PT240H</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>
        <serviceTask id="recordarRevisor2" name="Recordar revisor 2" flowable:delegateExpression="${recordatorioRevisor2}"></serviceTask>
        <sequenceFlow id="flow8" sourceRef="timerRevisor2" targetRef="recordarRevisor2"></sequenceFlow>
        <sequenceFlow id="flow9" sourceRef="revisarR2" targetRef="syncRevisores"></sequenceFlow>
        <parallelGateway id="syncRevisores" name="Esperar revisores"></parallelGateway>
        <exclusiveGateway id="decisionNota" name="¿Nota mayor a 11?"></exclusiveGateway>
        <sequenceFlow id="flow10" sourceRef="syncRevisores" targetRef="decisionNota"></sequenceFlow>
        <userTask id="generarActa" name="Generar acta de aprobación" flowable:assignee="${idDireccion}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <userTask id="notificarRechazo" name="Notificar rechazo al estudiante" flowable:assignee="${idDireccion}" flowable:formFieldValidation="true">
            <extensionElements>
                <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
            </extensionElements>
        </userTask>
        <endEvent id="theEnd" name="Tema no Valido"></endEvent>
        <sequenceFlow id="flow3" sourceRef="designarRevisores" targetRef="paraleloRevision"></sequenceFlow>
        <sequenceFlow id="flow5" sourceRef="timerRevisor1" targetRef="recordarRevisor1"></sequenceFlow>
        <sequenceFlow id="flow7" sourceRef="paraleloRevision" targetRef="revisarR2"></sequenceFlow>
